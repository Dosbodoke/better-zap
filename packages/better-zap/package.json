{
  "name": "better-zap",
  "version": "25.0.4",
  "description": "Framework-agnostic Better Zap core for typed WhatsApp integrations.",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dosbodoke/better-zap.git",
    "directory": "packages/better-zap"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.mts",
        "default": "./dist/client.mjs"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./s3": {
      "import": {
        "types": "./dist/s3.d.mts",
        "default": "./dist/s3.mjs"
      },
      "require": {
        "types": "./dist/s3.d.cts",
        "default": "./dist/s3.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package:check": "publint --strict && attw --pack --profile node16"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@better-zap/fixtures": "workspace:*",
    "@types/node": "^25.4.0",
    "tsdown": "^0.21.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.0"
  }
}

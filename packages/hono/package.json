{
  "name": "@better-zap/hono",
  "version": "0.2.1",
  "description": "Hono adapter and webhook runtime for Better Zap.",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dosbodoke/better-zap.git",
    "directory": "packages/hono"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package:check": "publint --strict && attw --pack --profile node16"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "dependencies": {
    "better-zap": "workspace:*",
    "hono": "^4.12.25"
  },
  "peerDependencies": {
    "hono": "^4.12.25"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "@types/node": "^25.4.0",
    "tsdown": "^0.21.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.0"
  }
}

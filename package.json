{
  "name": "better-zap-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "pnpm --filter \"./packages/better-zap\" --filter \"./packages/react\" --filter \"./packages/hono\" --filter \"./packages/cli\" --filter \"./packages/fixtures\" -r build",
    "typecheck": "pnpm --filter \"./packages/better-zap\" --filter \"./packages/react\" --filter \"./packages/hono\" --filter \"./packages/cli\" --filter \"./packages/fixtures\" -r typecheck",
    "landing:typecheck": "pnpm --dir landing typecheck",
    "test": "pnpm --filter \"./packages/better-zap\" --filter \"./packages/react\" --filter \"./packages/hono\" --filter \"./packages/cli\" --filter \"./packages/fixtures\" -r test",
    "pack:check": "pnpm --filter \"./packages/better-zap\" --filter \"./packages/react\" --filter \"./packages/hono\" --filter \"./packages/cli\" --filter \"./packages/fixtures\" -r package:check",
    "release:check": "pnpm release:check-version && pnpm test:release-version && pnpm build && pnpm typecheck && pnpm landing:typecheck && pnpm test && pnpm pack:check && pnpm changeset status --verbose",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm release:check-version",
    "release:publish": "pnpm release:check-version && changeset publish",
    "release:publish:next": "pnpm release:check-version:next && changeset publish --tag next --no-git-tag",
    "release:check-version": "node scripts/check-release-version.mjs --mode stable",
    "release:check-version:next": "node scripts/check-release-version.mjs --mode next",
    "release:require-changeset": "node scripts/check-release-version.mjs --require-changeset",
    "test:release-version": "node --test scripts/check-release-version.test.mjs",
    "version-packages:next": "changeset version --snapshot next"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.4.6",
    "@changesets/cli": "^2.29.7",
    "@types/node": "^25.4.0",
    "publint": "^0.3.21",
    "tsdown": "^0.21.2",
    "turbo": "^2.8.16",
    "typescript": "^6.0.2",
    "vitest": "^4.1.0"
  }
}
